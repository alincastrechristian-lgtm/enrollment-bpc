# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Separate, stable key for stored service credentials. Keep outside the database/Gateway.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Accepts 32 to 64 random bytes as hex. Back up this key separately from the database.
DATA_ENCRYPTION_KEY=

# Only used by docker-compose.defense.yml. Never reuse the app encryption/auth secret.
DRIZZLE_GATEWAY_MASTERPASS=

INITIAL_ADMIN_EMAIL=admin@admin.com
INITIAL_ADMIN_PASSWORD=admin123

# Optional one-time import. Manage the saved key under Settings > Clearance.
GEMINI_API_KEY=

# Optional Garage: startup ensures bucket bpc exists when both admin values are set.
# GARAGE_ADMIN_TOKEN must match Garage's [admin].admin_token.
# Fresh single-node layout is initialized automatically with 10 GB in zone dc1.
GARAGE_API_ENDPOINT=http://localhost:3900
GARAGE_ADMIN_ENDPOINT=http://localhost:3903
GARAGE_ADMIN_TOKEN=garage-admin-token
GARAGE_METRICS_TOKEN=garage-metrics-token

# GARAGE_REGION must match [s3_api].s3_region in garage.toml.
GARAGE_REGION=garage
# S3 key is provisioned automatically. DB stores its ID/name; secret stays in server memory.

# Node adapter: allow two handwriting crops and bounded 10 MiB file uploads.
BODY_SIZE_LIMIT=20M
